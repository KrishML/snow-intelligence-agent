# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://snow:snow@localhost:5432/snow_agent

# ─── Application ─────────────────────────────────────────────────────────────
# Accepted values: sports | tourism
DEFAULT_MODE=sports
API_BEARER_TOKEN=
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
# JSON list of user IDs allowed to use POST /api/dashboard/refresh
ADMIN_USER_IDS=["00000000-0000-0000-0000-000000000001"]

# ─── Redis (chat sessions, live-call limits; 24h TTL) ────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL_SECONDS=86400

# ─── Open-Meteo ──────────────────────────────────────────────────────────────
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_CONCURRENCY=10
OPEN_METEO_TIMEOUT_SECONDS=30.0
OPEN_METEO_MAX_RETRIES=3

# ─── Scoring ─────────────────────────────────────────────────────────────────
SPORTS_DEPTH_GATE_CM=40
TOURISM_DEPTH_GATE_CM=15
FORECAST_RAIN_EXCLUDE_THRESHOLD_MM=0.1
FORECAST_TEMP_EXCLUDE_THRESHOLD_C=3.0
HISTORICAL_YEARS=5

# ─── Scheduler ───────────────────────────────────────────────────────────────
WEEKLY_RUN_DAY=fri
WEEKLY_RUN_HOUR=17
WEEKLY_RUN_MINUTE=0
WEEKLY_RUN_TIMEZONE=UTC

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL_CHAT=gpt-4o
OPENAI_MODEL_QUALITATIVE=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_VISION_TIMEOUT_SECONDS=30.0

# ─── Reddit (praw) ───────────────────────────────────────────────────────────
# Create an app at https://www.reddit.com/prefs/apps (script type)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=snow-agent/2.0
REDDIT_POST_LIMIT=10
REDDIT_LOOKBACK_DAYS=7

# ─── Webcam ───────────────────────────────────────────────────────────────────
WEBCAM_TIMEOUT_SECONDS=5.0
WEBCAM_SNAPSHOT_DIR=snapshots
WEBCAM_CONCURRENCY=5
# local | s3 (s3 uses the standard AWS credential chain)
WEBCAM_STORAGE_BACKEND=local
WEBCAM_S3_BUCKET=
WEBCAM_S3_PREFIX=webcams
WEBCAM_RETENTION_DAYS=90

# ─── Evidence sources ──────────────────────────────────────────────────────────
# {resort name: https URL} for official snow reports
OFFICIAL_REPORT_SOURCES_FILE=data/report_sources.json
# JSON list of travel-blog RSS feeds used in tourism mode
TOURISM_RSS_FEEDS=[]

# ─── Qualitative scoring ─────────────────────────────────────────────────────
QUALITATIVE_CONCURRENCY=5
QUALITATIVE_TIMEOUT_MINUTES=8.0

# ─── Telegram ────────────────────────────────────────────────────────────────
# Create a bot at https://t.me/BotFather  — send /newbot
# Get your chat_id by messaging your bot then hitting:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── SendGrid ────────────────────────────────────────────────────────────────
# Free tier at https://signup.sendgrid.com (100 emails/day)
SENDGRID_API_KEY=SG.
SENDGRID_FROM_EMAIL=reports@snow-agent.io
DELIVERY_EMAIL_ADDRESS=

# ─── Amadeus (chat agent — read-only flight search) ──────────────────────────
# Free test credentials at https://developers.amadeus.com/register
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
