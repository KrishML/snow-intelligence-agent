# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://snow:snow@localhost:5432/snow_agent

# ─── Application ─────────────────────────────────────────────────────────────
# Accepted values: sports | tourism
DEFAULT_MODE=sports

# ─── Open-Meteo ──────────────────────────────────────────────────────────────
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_CONCURRENCY=10
OPEN_METEO_TIMEOUT_SECONDS=30.0
OPEN_METEO_MAX_RETRIES=3

# ─── Scoring ─────────────────────────────────────────────────────────────────
SPORTS_DEPTH_GATE_CM=40
TOURISM_DEPTH_GATE_CM=15
FORECAST_RAIN_EXCLUDE_THRESHOLD_MM=0.1
FORECAST_TEMP_EXCLUDE_THRESHOLD_C=3.0
HISTORICAL_YEARS=5

# ─── Scheduler ───────────────────────────────────────────────────────────────
WEEKLY_RUN_DAY=fri
WEEKLY_RUN_HOUR=17
WEEKLY_RUN_MINUTE=0
WEEKLY_RUN_TIMEZONE=UTC
