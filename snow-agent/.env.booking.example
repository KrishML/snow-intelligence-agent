# Booking service credentials. Keep this file separate from .env: the chat
# service must never see these values, and this service must never see chat keys
# (OPENAI_API_KEY, AMADEUS_*, REDDIT_*). Each service checks this at startup.

DATABASE_URL=postgresql+asyncpg://snow:snow@db:5432/snow_agent
BOOKING_API_TOKEN=
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001

# Duffel (use a test-mode token until real bookings are intended)
DUFFEL_API_KEY=
# Stripe (use a test-mode secret key until real payments are intended)
STRIPE_SECRET_KEY=
HOTEL_BOOKING_API_KEY=

PRICE_LOCK_MINUTES=10
MAX_BOOKING_TOTAL_GBP=5000

# Confirmation and failure notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=reports@snow-agent.io
DELIVERY_EMAIL_ADDRESS=
